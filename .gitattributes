# Normalize to LF in the repository. The repo is developed on Windows and built on
# Linux (WSL2), and shell scripts + Rust sources must not acquire CRLF.
* text=auto eol=lf

*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Evidence logs. One of these was once written by a Windows PowerShell redirect, which
# produces UTF-16LE with a BOM: unreadable on Linux and macOS, and treated as binary by
# git, so the evidence could not be reviewed or diffed at all. Declaring them text stops
# that recurring. Prefer `cmd /c ... > log` or an explicit UTF-8 writer on Windows.
*.log text eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts are never normalized.
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.ico binary
*.woff binary
*.woff2 binary
